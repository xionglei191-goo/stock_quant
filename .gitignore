# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.playwright-mcp/
.coverage
.coverage.*
htmlcov/

# Packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Local environment files
.env
.env.*
!.env.example

# Editor and OS files
.idea/
.vscode/
.DS_Store
*.log

# Local runtime state
data/state.db
data/local/
data/artifacts/
data/objects/*

# Local generated acceptance and runtime artifacts.
artifacts/*
!artifacts/*.example.json

# Local object-store writes generated by tests and staging drills.
# Existing tracked demo objects remain tracked; this only keeps new runtime
# objects out of day-to-day status noise.
data/objects/local_research_reports/
data/objects/sec_edgar/doc_security_cache_expired_*.txt
data/objects/src_sec/doc_cache_expired.txt
data/objects/src_sec/doc_executor_*.txt
data/objects/src_sec/doc_gpu_*.txt
data/objects/src_sec/doc_portfolio_*.txt
data/objects/src_sec/doc_search_*.txt
data/objects/src_sec/doc_sensitive.txt
